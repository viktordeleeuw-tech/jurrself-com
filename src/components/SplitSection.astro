---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  id?: string;
  dark?: boolean;
  imageSide?: 'left' | 'right';
  mobileFirst?: 'image' | 'text';
  size?: 'tall' | 'medium';
}

const {
  image,
  alt,
  id,
  dark = false,
  imageSide = 'left',
  mobileFirst = 'image',
  size,
} = Astro.props;

const splitClass = ['jf-split', size && `jf-split--${size}`].filter(Boolean).join(' ');
const mediaClass = `jf-split__media jf-order-${imageSide === 'left' ? '1' : '2'}`;
const textClass = `jf-split__text jf-order-${imageSide === 'left' ? '2' : '1'}${dark ? ' jf-split__text--dark' : ''}`;
---

<section id={id} class={splitClass}>
  {
    mobileFirst === 'image' ? (
      <Fragment>
        <div class={mediaClass}>
          <Image src={image} alt={alt} class="jf-photo" widths={[480, 960, 1280]} sizes="(min-width: 768px) 50vw, 100vw" />
        </div>
        <div class={textClass}>
          <slot />
        </div>
      </Fragment>
    ) : (
      <Fragment>
        <div class={textClass}>
          <slot />
        </div>
        <div class={mediaClass}>
          <Image src={image} alt={alt} class="jf-photo" widths={[480, 960, 1280]} sizes="(min-width: 768px) 50vw, 100vw" />
        </div>
      </Fragment>
    )
  }
</section>
