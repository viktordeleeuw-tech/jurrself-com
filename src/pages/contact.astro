---
import Layout from '../layouts/Layout.astro';

// ponytail: placeholders until Viktor supplies the real contact details.
const whatsappNumber = '+34 612 461 622';
const contactEmail = 'info@jurrself.com';
const whatsappHref = `https://wa.me/${whatsappNumber.replace(/[^0-9]/g, '')}`;
---

<Layout
  title="Contact — JurrSelf"
  description="Boek je JurrSelf sessie of maak eerst kennis. Vul het formulier in of neem contact op via WhatsApp of e-mail."
>
  <section id="kennismaken" class="jf-container jf-contact-hero">
    <p class="jf-eyebrow">Contact</p>
    <h1 class="jf-h1 jf-h1--wide">Boek je sessie of<br />maak eerst kennis.</h1>
    <p class="jf-lead jf-lead--sm jf-max-w-md">Vul het formulier in en we nemen persoonlijk contact met je op om te bespreken wat het beste past, de Experience of het Traject.</p>
  </section>

  <section class="jf-container jf-contact">
    <form id="contact-form" class="jf-form">
      <label class="jf-form__field">
        Naam
        <input class="jf-form__input" name="name" required type="text" placeholder="Je naam" />
      </label>
      <label class="jf-form__field">
        E-mail
        <input class="jf-form__input" name="email" required type="email" placeholder="jij@voorbeeld.nl" />
      </label>
      <label class="jf-form__field">
        Bericht
        <textarea class="jf-form__input" name="message" rows="4" placeholder="Vertel kort waar je naar op zoek bent, Experience, Traject, of je hebt eerst een vraag."></textarea>
      </label>
      <button type="submit" class="jf-btn jf-btn--dark jf-form__submit">Verstuur aanvraag</button>
    </form>

    <div id="contact-confirm" class="jf-confirm" hidden>
      <p>Bedankt, <span id="confirm-name"></span>.</p>
      <p>We nemen zo snel mogelijk persoonlijk contact met je op.</p>
    </div>

    <div class="jf-contact-info">
      <div class="jf-contact-info__block">
        <p>WhatsApp</p>
        <a href={whatsappHref} class="jf-contact-info__link">{whatsappNumber}</a>
        <p class="jf-contact-info__note">Voor het Traject bespreken we eerst persoonlijk wat het beste past.</p>
      </div>
      <div class="jf-contact-info__block">
        <p>E-mail</p>
        <a href={`mailto:${contactEmail}`} class="jf-contact-info__link">{contactEmail}</a>
      </div>
      <div class="jf-contact-info__block">
        <p>Locatie</p>
        <p class="jf-contact-info__text">Javea, Spanje.<br />Private locatie, adres volgt persoonlijk na boeking.</p>
      </div>
    </div>
  </section>

  <section class="jf-container jf-container--prose jf-pb-lg">
    <p class="jf-eyebrow jf-eyebrow--gap">Veelgestelde vragen</p>
    <div class="jf-faq">
      <details class="jf-faq__item">
        <summary>Moet ik fit zijn om mee te doen?</summary>
        <p>Nee. De intensiteit past zich aan jouw niveau aan. Het gaat niet om prestatie, maar om ervaren wat er in je lichaam gebeurt.</p>
      </details>
      <details class="jf-faq__item">
        <summary>Wat moet ik meenemen?</summary>
        <p>Zwemkleding, een handdoek en warme kleding voor na afloop. De rest, zoals materiaal voor ademwerk en het ijsbad, is aanwezig.</p>
      </details>
      <details class="jf-faq__item">
        <summary>Is dit veilig met een hartaandoening of tijdens zwangerschap?</summary>
        <p>Overleg altijd eerst met je arts. Ademwerk en koudeblootstelling zijn intensief voor het lichaam en niet voor iedereen zonder overleg geschikt.</p>
      </details>
      <details class="jf-faq__item">
        <summary>Waar vindt de sessie plaats?</summary>
        <p>Op een private locatie in Javea. Het exacte adres deel je persoonlijk na je boeking.</p>
      </details>
      <details class="jf-faq__item">
        <summary>Wat is het verschil tussen de Experience en het Traject?</summary>
        <p>De Experience is één intensieve sessie om kennis te maken. Het Traject is vijf sessies voor wie de principes echt wil leren herkennen en toepassen.</p>
      </details>
    </div>
  </section>
</Layout>

<script>
  // ponytail: no backend wired up yet — shows a local thank-you state only.
  // Swap for a real submit handler (Formspree/Brevo/etc.) when the backend is chosen.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const confirm = document.getElementById('contact-confirm');
  const confirmName = document.getElementById('confirm-name');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const name = (form.elements.namedItem('name') as HTMLInputElement)?.value || 'jij';
    if (confirmName) confirmName.textContent = name;
    form.hidden = true;
    confirm?.removeAttribute('hidden');
  });
</script>
